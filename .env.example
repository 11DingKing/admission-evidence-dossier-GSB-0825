# ============================================================
# 投档来源卷宗系统 — 环境变量样例
# 后端（backend/，Spring Boot）与前端（apps/web，Vite）分别启动
# 复制为 .env 后按需修改；.env 仅为本地约定，也可直接在 shell 中导出
# ============================================================

# ---------- 后端 API ----------
# HTTP 端口
API_PORT=8080
# PostgreSQL 16 连接串（首次启动 Flyway 自动建表并写入固定 seed）
DB_URL=jdbc:postgresql://localhost:5432/admission_dossier
DB_USERNAME=postgres
DB_PASSWORD=postgres
# 允许跨域访问 API 的前端来源（逗号分隔；开发时 Vite 默认跑在 5173）
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 前端 Web ----------
# 前端访问的 API 基址。开发时指向后端：
VITE_API_BASE_URL=http://localhost:8080/api/v1
# 生产同源部署（反向代理 /api 到后端）时可留空，默认即 /api/v1
